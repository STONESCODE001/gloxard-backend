# ==============================================================================
# GLOXAD ACADEMY BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE (MONGODB)
# ------------------------------------------------------------------------------
# MongoDB connection string (local or MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>.mongodb.net/gloxad?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Secure signing key for JWT tokens (must be at least 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_example
# Token validity period (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. EMAIL DISPATCH (SMTP / BREVO / RESEND)
# ------------------------------------------------------------------------------
# SMTP configuration (Brevo, SendGrid, Gmail, etc.)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login_username@example.com
SMTP_PASS=your_smtp_password_or_master_key
SMTP_FROM="Gloxad Academy" <noreply@gloxad.com>

# Optional Resend API key (fallback or primary HTTP email provider)
RESEND_APIKEY=re_123456789_example

# ------------------------------------------------------------------------------
# 5. AWS S3 STORAGE (PRESIGNED UPLOADS & CERTIFICATES)
# ------------------------------------------------------------------------------
# AWS credentials with PutObject / GetObject permissions on the target bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=gloxad-academy-media-bucket

# ------------------------------------------------------------------------------
# 6. PAYSTACK PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Secret key obtained from your Paystack Dashboard (test or live)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 7. LIVEKIT CLOUD (WEBRTC LIVE CLASSROOMS)
# ------------------------------------------------------------------------------
# Project WebSocket URL and API credentials from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=sec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx